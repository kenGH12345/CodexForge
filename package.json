    "test:effective-lines": "node workflow/tests/run-all-tests.js --file=integration-effective-lines",
    "test:pipeline": "node workflow/tests/run-all-tests.js --file=integration-pipeline-flow",
    "test:agent": "node workflow/tests/run-all-tests.js --file=integration-agent-fusion",
    "test:framework": "node workflow/tests/run-all-tests.js --file=integration-framework-fusion"
